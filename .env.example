# Copy this file to .env and fill in real values. Never commit .env itself.

# Required API Keys
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Model configuration
GEMINI_MODEL=gemini-3.5-flash-lite

# PDF Engine: "weasyprint" (better CSS fidelity, requires native GTK) or "xhtml2pdf" (pure Python)
PDF_ENGINE=xhtml2pdf

# Directories
OUTPUT_DIR=outputs
CACHE_DIR=cache
CACHE_TTL_HOURS=12

# Agent parameters
RESEARCH_AGENT_MAX_TURNS=4
OUTLOOK_MONTHS=6
